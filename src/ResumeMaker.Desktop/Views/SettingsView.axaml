<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeMaker.Desktop.ViewModels"
             x:Class="ResumeMaker.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Classes="page">
    <TextBlock Classes="h1" Text="{Binding Loc[settings.title]}" />

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Loc[settings.theme]}" />
        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" MinWidth="220"
                  AutomationProperties.Name="{Binding Loc[settings.theme]}" />
        <TextBlock Classes="muted" Text="{Binding Loc[settings.theme_hint]}" />

        <TextBlock Text="{Binding Loc[settings.ui_language]}" />
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedUiLanguage}" MinWidth="220"
                  AutomationProperties.Name="{Binding Loc[settings.ui_language]}" />

        <TextBlock Text="{Binding Loc[settings.resume_language]}" />
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedResumeLanguage}" MinWidth="220"
                  AutomationProperties.Name="{Binding Loc[settings.resume_language]}" />

        <TextBlock Text="{Binding Loc[settings.chrome_path]}" />
        <TextBox Text="{Binding ChromePath}" Watermark="C:\Program Files\Google\Chrome\Application\chrome.exe"
                 FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Loc[settings.chrome_path]}" />
        <TextBlock Classes="muted" Text="{Binding Loc[settings.chrome_hint]}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
